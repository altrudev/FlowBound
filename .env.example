# FlowBound Nebius competition path
FLOWBOUND_BACKEND=memory
FLOWBOUND_AGENT_MODE=nebius

# Never commit a real key. Create one in Nebius Token Factory.
NEBIUS_API_KEY=

# OpenAI-compatible Token Factory endpoint and NVIDIA models.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional stronger evidence-challenge pass:
NEBIUS_EVIDENCE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Server-side capability envelope; the model cannot change this.
FLOWBOUND_AGENT_AUTHORITIES=remediation:create,followup:schedule,case:close
